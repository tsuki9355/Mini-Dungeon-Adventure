{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Mini Dungeon",
            "type": "process",
            "command": "${workspaceFolder}/build.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build Mini Dungeon (g++)",
            "type": "shell",
            "command": "g++",
            "args": ["-std=c++17", "-Wall", "-Wextra", "-g", "src/*.cpp", "-o", "build/dungeon"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}
